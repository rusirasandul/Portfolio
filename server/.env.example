# Environment Variables
# Create a .env file in the server directory and add your API key

# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Coffee bookings storage — free Upstash Redis (https://console.upstash.com)
# or Vercel → Storage → "Upstash for Redis" (KV_REST_API_URL / KV_REST_API_TOKEN also work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server Port (optional, defaults to 5000)
PORT=5000